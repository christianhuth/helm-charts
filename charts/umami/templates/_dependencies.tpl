{{/*
Interface to the PostgreSQL database used by Umami: either the bundled PostgreSQL cluster (see _postgresql.tpl),
the external database configured with externalDatabase.* or a complete database URL from database.existingSecret
*/}}

{{- define "umami.database.hostname" -}}
  {{- if .Values.postgresql.enabled -}}
    {{- include "christianhuth.postgresql.hostname" .Subcharts.postgresql -}}
  {{- else -}}
    {{- required "externalDatabase.hostname is required if postgresql.enabled is false" (tpl .Values.externalDatabase.hostname $) -}}
  {{- end -}}
{{- end -}}

{{- define "umami.database.port" -}}
  {{- if .Values.postgresql.enabled -}}
    {{- include "christianhuth.postgresql.port" .Subcharts.postgresql -}}
  {{- else -}}
    {{- .Values.externalDatabase.port | default 5432 | toString -}}
  {{- end -}}
{{- end -}}

{{- define "umami.database.database" -}}
  {{- if .Values.postgresql.enabled -}}
    {{- include "christianhuth.postgresql.database" .Subcharts.postgresql -}}
  {{- else -}}
    {{- tpl .Values.externalDatabase.database $ -}}
  {{- end -}}
{{- end -}}

{{- define "umami.database.username" -}}
  {{- if .Values.postgresql.enabled -}}
    {{- include "christianhuth.postgresql.username" .Subcharts.postgresql -}}
  {{- else -}}
    {{- tpl .Values.externalDatabase.username $ -}}
  {{- end -}}
{{- end -}}

{{- define "umami.database.secretName" -}}
  {{- if .Values.postgresql.enabled -}}
    {{- include "christianhuth.postgresql.secretName" .Subcharts.postgresql -}}
  {{- else if .Values.externalDatabase.existingSecret -}}
    {{- tpl .Values.externalDatabase.existingSecret $ -}}
  {{- else -}}
    {{- printf "%s-database" (include "umami.fullname" .) -}}
  {{- end -}}
{{- end -}}

{{- define "umami.database.passwordKey" -}}
  {{- if .Values.postgresql.enabled -}}
    {{- include "christianhuth.postgresql.passwordKey" .Subcharts.postgresql -}}
  {{- else if .Values.externalDatabase.existingSecret -}}
    {{- .Values.externalDatabase.existingSecretPasswordKey | default "password" -}}
  {{- else -}}
    {{- "password" -}}
  {{- end -}}
{{- end -}}

{{/*
Render the environment variables providing DATABASE_URL:
- from the complete URL in database.existingSecret, if set
- from the connection URI in the Secret generated by the operator for the bundled database
- otherwise assembled from the password Secret with Kubernetes variable expansion (the password must be URL-safe)
*/}}
{{- define "umami.database.env" -}}
{{- if .Values.database.existingSecret }}
- name: DATABASE_URL
  valueFrom:
    secretKeyRef:
      name: {{ tpl .Values.database.existingSecret $ | quote }}
      key: {{ .Values.database.databaseUrlKey | default "database-url" | quote }}
{{- else if and .Values.postgresql.enabled (include "christianhuth.postgresql.generatedSecret" .Subcharts.postgresql) }}
- name: DATABASE_URL
  valueFrom:
    secretKeyRef:
      name: {{ include "umami.database.secretName" . | quote }}
      key: {{ include "christianhuth.postgresql.uriKey" .Subcharts.postgresql | quote }}
{{- else }}
- name: UMAMI_DATABASE_PASSWORD
  valueFrom:
    secretKeyRef:
      name: {{ include "umami.database.secretName" . | quote }}
      key: {{ include "umami.database.passwordKey" . | quote }}
- name: DATABASE_URL
  value: {{ printf "postgresql://%s:$(UMAMI_DATABASE_PASSWORD)@%s:%s/%s" (include "umami.database.username" .) (include "umami.database.hostname" .) (include "umami.database.port" .) (include "umami.database.database" .) | quote }}
{{- end }}
{{- end -}}

{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "properties": {
    "affinity": {
      "description": "Affinity settings for pod assignment",
      "required": [],
      "title": "affinity",
      "type": "object"
    },
    "autoscaling": {
      "properties": {
        "enabled": {
          "default": false,
          "title": "enabled",
          "type": "boolean"
        },
        "maxReplicas": {
          "default": 100,
          "title": "maxReplicas",
          "type": "integer"
        },
        "minReplicas": {
          "default": 1,
          "title": "minReplicas",
          "type": "integer"
        },
        "targetCPUUtilizationPercentage": {
          "default": 80,
          "title": "targetCPUUtilizationPercentage",
          "type": "integer"
        }
      },
      "required": [
        "enabled",
        "minReplicas",
        "maxReplicas",
        "targetCPUUtilizationPercentage"
      ],
      "title": "autoscaling",
      "type": "object"
    },
    "deploymentStrategy": {
      "description": "Update strategy for the deployment",
      "required": [],
      "title": "deploymentStrategy",
      "type": "object"
    },
    "externalDatabase": {
      "properties": {
        "database": {
          "default": "typo3",
          "description": "Name of the database to use",
          "title": "database",
          "type": "string"
        },
        "existingSecret": {
          "default": "",
          "description": "Name of an existing Secret containing the password of the user",
          "title": "existingSecret",
          "type": "string"
        },
        "existingSecretPasswordKey": {
          "default": "password",
          "description": "Key in the existing Secret containing the password",
          "title": "existingSecretPasswordKey",
          "type": "string"
        },
        "hostname": {
          "default": "",
          "description": "Hostname of the external MariaDB or MySQL database. Used if `mariadb.enabled` is false.",
          "title": "hostname",
          "type": "string"
        },
        "password": {
          "default": "",
          "description": "Password of the user. Ignored if `externalDatabase.existingSecret` is set.",
          "title": "password",
          "type": "string"
        },
        "port": {
          "default": 3306,
          "description": "Port of the external database",
          "title": "port",
          "type": "integer"
        },
        "username": {
          "default": "typo3",
          "description": "Name of the user to use",
          "title": "username",
          "type": "string"
        }
      },
      "required": [
        "hostname",
        "port",
        "database",
        "username",
        "password",
        "existingSecret",
        "existingSecretPasswordKey"
      ],
      "title": "externalDatabase",
      "type": "object"
    },
    "fullnameOverride": {
      "default": "",
      "description": "String to fully override `\"typo3.fullname\"`",
      "title": "fullnameOverride",
      "type": "string"
    },
    "global": {
      "description": "Global values are values that can be accessed from any chart or subchart by exactly the same name.",
      "required": [],
      "title": "global",
      "type": "object"
    },
    "image": {
      "properties": {
        "pullPolicy": {
          "default": "Always",
          "description": "image pull policy",
          "title": "pullPolicy",
          "type": "string"
        },
        "registry": {
          "default": "docker.io",
          "description": "image registry",
          "title": "registry",
          "type": "string"
        },
        "repository": {
          "default": "crinis/typo3",
          "description": "image repository",
          "title": "repository",
          "type": "string"
        },
        "tag": {
          "default": "legacy-13.4.36",
          "description": "Overrides the image tag",
          "title": "tag",
          "type": "string"
        }
      },
      "required": [
        "registry",
        "repository",
        "pullPolicy",
        "tag"
      ],
      "title": "image",
      "type": "object"
    },
    "imagePullSecrets": {
      "description": "If defined, uses a Secret to pull an image from a private Docker registry or repository.",
      "items": {
        "required": []
      },
      "title": "imagePullSecrets",
      "type": "array"
    },
    "ingress": {
      "properties": {
        "annotations": {
          "required": [],
          "title": "annotations",
          "type": "object"
        },
        "className": {
          "default": "",
          "title": "className",
          "type": "string"
        },
        "enabled": {
          "default": false,
          "title": "enabled",
          "type": "boolean"
        },
        "hosts": {
          "description": "kubernetes.io/ingress.class: nginx\nkubernetes.io/tls-acme: \"true\"",
          "items": {
            "anyOf": [
              {
                "properties": {
                  "host": {
                    "default": "chart-example.local",
                    "title": "host",
                    "type": "string"
                  },
                  "paths": {
                    "items": {
                      "anyOf": [
                        {
                          "properties": {
                            "path": {
                              "default": "/",
                              "title": "path",
                              "type": "string"
                            },
                            "pathType": {
                              "default": "ImplementationSpecific",
                              "title": "pathType",
                              "type": "string"
                            }
                          },
                          "required": [
                            "path",
                            "pathType"
                          ],
                          "type": "object"
                        }
                      ],
                      "required": []
                    },
                    "title": "paths",
                    "type": "array"
                  }
                },
                "required": [
                  "host",
                  "paths"
                ],
                "type": "object"
              }
            ],
            "required": []
          },
          "title": "hosts",
          "type": "array"
        },
        "tls": {
          "items": {
            "required": []
          },
          "title": "tls",
          "type": "array"
        }
      },
      "required": [
        "enabled",
        "className",
        "annotations",
        "hosts",
        "tls"
      ],
      "title": "ingress",
      "type": "object"
    },
    "livenessProbe": {
      "properties": {
        "failureThreshold": {
          "default": 3,
          "description": "Failure threshold for livenessProbe",
          "title": "failureThreshold",
          "type": "integer"
        },
        "httpGet": {
          "properties": {
            "path": {
              "default": "/typo3/",
              "description": "Path for livenessProbe",
              "title": "path",
              "type": "string"
            }
          },
          "required": [
            "path"
          ],
          "title": "httpGet",
          "type": "object"
        },
        "initialDelaySeconds": {
          "default": 0,
          "description": "Initial delay seconds for livenessProbe",
          "title": "initialDelaySeconds",
          "type": "integer"
        },
        "periodSeconds": {
          "default": 10,
          "description": "Period seconds for livenessProbe",
          "title": "periodSeconds",
          "type": "integer"
        },
        "successThreshold": {
          "default": 1,
          "description": "Success threshold for livenessProbe",
          "title": "successThreshold",
          "type": "integer"
        },
        "timeoutSeconds": {
          "default": 5,
          "description": "Timeout seconds for livenessProbe",
          "title": "timeoutSeconds",
          "type": "integer"
        }
      },
      "required": [
        "failureThreshold",
        "httpGet",
        "initialDelaySeconds",
        "periodSeconds",
        "successThreshold",
        "timeoutSeconds"
      ],
      "title": "livenessProbe",
      "type": "object"
    },
    "mariadb": {
      "properties": {
        "enabled": {
          "default": true,
          "description": "Enable a MariaDB instance managed by the mariadb-operator. Requires the operator to be installed in the cluster (see README).",
          "title": "enabled",
          "type": "boolean"
        },
        "mariadb": {
          "properties": {
            "database": {
              "default": "typo3",
              "description": "Name of the database to create",
              "title": "database",
              "type": "string"
            },
            "galera": {
              "properties": {
                "enabled": {
                  "default": true,
                  "description": "Enable Galera to run multiple instances",
                  "title": "enabled",
                  "type": "boolean"
                }
              },
              "required": [
                "enabled"
              ],
              "title": "galera",
              "type": "object"
            },
            "image": {
              "default": "mariadb:13.0",
              "description": "MariaDB image. The tag only pins the release series (13.0 is the current long-term support release), so restarted instances get its latest patch version.",
              "title": "image",
              "type": "string"
            },
            "imagePullPolicy": {
              "default": "Always",
              "description": "Pull the image on every start to get the latest patch version of the release series",
              "title": "imagePullPolicy",
              "type": "string"
            },
            "passwordSecretKeyRef": {
              "properties": {
                "generate": {
                  "default": true,
                  "description": "Let the operator generate the Secret with a random password if it does not exist",
                  "title": "generate",
                  "type": "boolean"
                },
                "key": {
                  "default": "password",
                  "description": "Key of the password inside the Secret",
                  "title": "key",
                  "type": "string"
                },
                "name": {
                  "default": "",
                  "description": "Name of an existing Secret containing the password of the user. If empty, the Secret `\u003crelease\u003e-mariadb-password` is used.",
                  "title": "name",
                  "type": "string"
                }
              },
              "required": [
                "name",
                "key",
                "generate"
              ],
              "title": "passwordSecretKeyRef",
              "type": "object"
            },
            "replicas": {
              "default": 3,
              "description": "Number of MariaDB instances. More than one instance requires Galera or replication.",
              "title": "replicas",
              "type": "integer"
            },
            "storage": {
              "properties": {
                "size": {
                  "default": "8Gi",
                  "description": "Size of the PVC of each instance",
                  "title": "size",
                  "type": "string"
                }
              },
              "required": [
                "size"
              ],
              "title": "storage",
              "type": "object"
            },
            "updateStrategy": {
              "properties": {
                "mariadbAutoUpgradeEnabled": {
                  "default": true,
                  "description": "Run `mariadb-upgrade` on start, so that changing the release series in `image` migrates the system schema. It is a no-op if there is nothing to migrate.",
                  "title": "mariadbAutoUpgradeEnabled",
                  "type": "boolean"
                }
              },
              "required": [
                "mariadbAutoUpgradeEnabled"
              ],
              "title": "updateStrategy",
              "type": "object"
            },
            "username": {
              "default": "typo3",
              "description": "Name of the user to create",
              "title": "username",
              "type": "string"
            }
          },
          "required": [
            "image",
            "imagePullPolicy",
            "updateStrategy",
            "replicas",
            "galera",
            "database",
            "username",
            "passwordSecretKeyRef",
            "storage"
          ],
          "title": "mariadb",
          "type": "object"
        }
      },
      "required": [
        "enabled",
        "mariadb"
      ],
      "title": "mariadb",
      "type": "object"
    },
    "nameOverride": {
      "default": "",
      "description": "Provide a name in place of `typo3`",
      "title": "nameOverride",
      "type": "string"
    },
    "nodeSelector": {
      "description": "Node labels for pod assignment",
      "required": [],
      "title": "nodeSelector",
      "type": "object"
    },
    "persistence": {
      "properties": {
        "fileadmin": {
          "properties": {
            "accessModes": {
              "description": "the desired access modes the volume should have.",
              "items": {
                "anyOf": [
                  {
                    "type": "string"
                  }
                ],
                "required": []
              },
              "title": "accessModes",
              "type": "array"
            },
            "annotations": {
              "description": "Annotations to be added to the PersistentVolumeClaim",
              "required": [],
              "title": "annotations",
              "type": "object"
            },
            "enabled": {
              "default": true,
              "description": "use a PVC to persist fileadmin data",
              "title": "enabled",
              "type": "boolean"
            },
            "existingClaim": {
              "default": "",
              "description": "provide an existing PersistentVolumeClaim",
              "title": "existingClaim",
              "type": "string"
            },
            "resources": {
              "description": "represents the minimum and maximum resources the volume should have.",
              "properties": {
                "requests": {
                  "properties": {
                    "storage": {
                      "default": "5Gi",
                      "title": "storage",
                      "type": "string"
                    }
                  },
                  "required": [
                    "storage"
                  ],
                  "title": "requests",
                  "type": "object"
                }
              },
              "required": [
                "requests"
              ],
              "title": "resources",
              "type": "object"
            },
            "storageClassName": {
              "default": "",
              "description": "Name of the StorageClass required by the claim.",
              "title": "storageClassName",
              "type": "string"
            }
          },
          "required": [
            "enabled",
            "accessModes",
            "annotations",
            "existingClaim",
            "storageClassName",
            "resources"
          ],
          "title": "fileadmin",
          "type": "object"
        },
        "typo3conf": {
          "properties": {
            "accessModes": {
              "description": "the desired access modes the volume should have.",
              "items": {
                "anyOf": [
                  {
                    "type": "string"
                  }
                ],
                "required": []
              },
              "title": "accessModes",
              "type": "array"
            },
            "annotations": {
              "description": "Annotations to be added to the PersistentVolumeClaim",
              "required": [],
              "title": "annotations",
              "type": "object"
            },
            "enabled": {
              "default": true,
              "description": "use a PVC to persist typo3conf data",
              "title": "enabled",
              "type": "boolean"
            },
            "existingClaim": {
              "default": "",
              "description": "provide an existing PersistentVolumeClaim",
              "title": "existingClaim",
              "type": "string"
            },
            "resources": {
              "description": "represents the minimum and maximum resources the volume should have.",
              "properties": {
                "requests": {
                  "properties": {
                    "storage": {
                      "default": "1Gi",
                      "title": "storage",
                      "type": "string"
                    }
                  },
                  "required": [
                    "storage"
                  ],
                  "title": "requests",
                  "type": "object"
                }
              },
              "required": [
                "requests"
              ],
              "title": "resources",
              "type": "object"
            },
            "storageClassName": {
              "default": "",
              "description": "Name of the StorageClass required by the claim.",
              "title": "storageClassName",
              "type": "string"
            }
          },
          "required": [
            "enabled",
            "accessModes",
            "annotations",
            "existingClaim",
            "storageClassName",
            "resources"
          ],
          "title": "typo3conf",
          "type": "object"
        }
      },
      "required": [
        "fileadmin",
        "typo3conf"
      ],
      "title": "persistence",
      "type": "object"
    },
    "podAnnotations": {
      "description": "Annotations to be added to exporter pods",
      "required": [],
      "title": "podAnnotations",
      "type": "object"
    },
    "podSecurityContext": {
      "description": "pod-level security context. TYPO3 runs rootless as `www-data` (33) and listens on port 8080. The image expects the user to be a member of the root group (`supplementalGroups`), as `/var/www/html` belongs to it.",
      "properties": {
        "fsGroup": {
          "default": 33,
          "title": "fsGroup",
          "type": "integer"
        },
        "runAsGroup": {
          "default": 33,
          "title": "runAsGroup",
          "type": "integer"
        },
        "runAsNonRoot": {
          "default": true,
          "title": "runAsNonRoot",
          "type": "boolean"
        },
        "runAsUser": {
          "default": 33,
          "title": "runAsUser",
          "type": "integer"
        },
        "seccompProfile": {
          "properties": {
            "type": {
              "default": "RuntimeDefault",
              "title": "type",
              "type": "string"
            }
          },
          "required": [
            "type"
          ],
          "title": "seccompProfile",
          "type": "object"
        },
        "supplementalGroups": {
          "items": {
            "anyOf": [
              {
                "type": "integer"
              }
            ],
            "required": []
          },
          "title": "supplementalGroups",
          "type": "array"
        }
      },
      "required": [
        "runAsNonRoot",
        "runAsUser",
        "runAsGroup",
        "fsGroup",
        "supplementalGroups",
        "seccompProfile"
      ],
      "title": "podSecurityContext",
      "type": "object"
    },
    "readinessProbe": {
      "properties": {
        "failureThreshold": {
          "default": 3,
          "description": "Failure threshold for readinessProbe",
          "title": "failureThreshold",
          "type": "integer"
        },
        "httpGet": {
          "properties": {
            "path": {
              "default": "/typo3/",
              "description": "Path for readinessProbe",
              "title": "path",
              "type": "string"
            }
          },
          "required": [
            "path"
          ],
          "title": "httpGet",
          "type": "object"
        },
        "initialDelaySeconds": {
          "default": 0,
          "description": "Initial delay seconds for readinessProbe",

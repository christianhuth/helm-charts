{{/*
DO NOT EDIT: this file is synced from .github/templates/_postgresql.tpl via .github/scripts/sync-shared-templates.sh

Named templates for a PostgreSQL cluster managed by the CloudNativePG operator.
It is bundled through the upstream chart https://github.com/cloudnative-pg/charts/tree/main/charts/cluster
as a dependency. All templates expect the context of that subchart, e.g.:

  {{ include "christianhuth.postgresql.hostname" .Subcharts.postgresql }}
  {{ include "christianhuth.postgresql.hostname" (index .Subcharts "my-alias") }}
*/}}

{{/*
Return the hostname of the read-write Service pointing to the primary instance
*/}}
{{- define "christianhuth.postgresql.hostname" -}}
  {{- printf "%s-rw" (include "cluster.fullname" .) -}}
{{- end -}}

{{/*
Return the port of the PostgreSQL Services
*/}}
{{- define "christianhuth.postgresql.port" -}}
  {{- "5432" -}}
{{- end -}}

{{/*
Return the name of the application database (defaults to "app" like the operator)
*/}}
{{- define "christianhuth.postgresql.database" -}}
  {{- .Values.cluster.initdb.database | default "app" -}}
{{- end -}}

{{/*
Return the owner of the application database (defaults to the database name like the operator)
*/}}
{{- define "christianhuth.postgresql.username" -}}
  {{- if .Values.cluster.initdb.owner -}}
    {{- tpl .Values.cluster.initdb.owner . -}}
  {{- else -}}
    {{- include "christianhuth.postgresql.database" . -}}
  {{- end -}}
{{- end -}}

{{/*
Return the name of the Secret containing the credentials of the owner. Either the existing
Secret given by cluster.initdb.secret.name or the Secret <fullname>-app generated by the operator.
*/}}
{{- define "christianhuth.postgresql.secretName" -}}
  {{- with (.Values.cluster.initdb.secret | default dict).name -}}
    {{- . -}}
  {{- else -}}
    {{- printf "%s-app" (include "cluster.fullname" .) -}}
  {{- end -}}
{{- end -}}

{{/*
Return the key of the password inside the credentials Secret
*/}}
{{- define "christianhuth.postgresql.passwordKey" -}}
  {{- "password" -}}
{{- end -}}

{{/*
Return "true" if the credentials Secret is generated by the operator. Only this Secret also contains
the connection URIs (keys uri, jdbc-uri, ...), an existing Secret only contains username and password.
*/}}
{{- define "christianhuth.postgresql.generatedSecret" -}}
  {{- if not (.Values.cluster.initdb.secret | default dict).name -}}
    {{- "true" -}}
  {{- end -}}
{{- end -}}

{{/*
Return the key of the connection URI (postgresql://<user>:<password>@<host>:<port>/<database>)
inside the credentials Secret. Only available if the Secret is generated by the operator,
check with "christianhuth.postgresql.generatedSecret" first.
*/}}
{{- define "christianhuth.postgresql.uriKey" -}}
  {{- if not (include "christianhuth.postgresql.generatedSecret" .) -}}
    {{- fail "The connection URI is only available in the Secret generated by the operator, but postgresql.cluster.initdb.secret.name is set" -}}
  {{- end -}}
  {{- "uri" -}}
{{- end -}}

{
  "$schema": "https://docs.renovatebot.com/renovate-schema.json",
  "extends": [
    "config:recommended",
    ":disableDependencyDashboard"
  ],
  "additionalBranchPrefix": "{{parentDir}}-",
  "assignees": ["christianhuth"],
  "bumpVersion": "patch",
  "ignorePaths": ["charts/baserow/**", "charts/passbolt-ha/**"],
  "labels": ["renovate"],
  "customManagers": [
    {
      "customType": "regex",
      "managerFilePatterns": ["/^charts/gateway-api-crds/Chart\\.yaml$/"],
      "matchStrings": ["appVersion:\\s*\"(?<currentValue>v[\\d.]+)\""],
      "datasourceTemplate": "github-releases",
      "depNameTemplate": "kubernetes-sigs/gateway-api"
    },
    {
      "description": "PostgreSQL major version of CloudNativePG clusters (postgresql.version.postgresql and postgresql.cluster.imageName)",
      "customType": "regex",
      "managerFilePatterns": ["/^charts/[^/]+/values\\.yaml$/"],
      "matchStrings": [
        "\\n\\s+version:\\n(?:\\s*#.*\\n)*\\s+postgresql: \"?(?<currentValue>\\d+)\"?\\n",
        "imageName: \"?(?<depName>ghcr\\.io/cloudnative-pg/postgresql):(?<currentValue>[^\"\\s]+)\"?"
      ],
      "datasourceTemplate": "docker",
      "depNameTemplate": "ghcr.io/cloudnative-pg/postgresql"
    }
  ],
  "packageRules": [
    {
      "matchManagers": ["helmv3"],
      "postUpgradeTasks": {
        "commands": ["bash ./renovate-update-chart-dependency.sh '{{{parentDir}}}' '{{{updateType}}}' '{{{depName}}}' '{{{newValue}}}'"],
        "executionMode": "branch"
      }
    },
    {
      "matchManagers": ["helm-values"],
      "postUpgradeTasks": {
        "commands": ["bash ./renovate-update-chart-values.sh '{{{parentDir}}}' '{{{updateType}}}' '{{{currentValue}}}' '{{{newValue}}}'"],
        "executionMode": "branch"
      }
    },
    {
      "matchManagers": ["custom.regex"],
      "matchDepNames": ["kubernetes-sigs/gateway-api"],
      "postUpgradeTasks": {
        "commands": ["bash ./renovate-update-gateway-api-crds.sh '{{{updateType}}}' '{{{currentValue}}}' '{{{newValue}}}'"],
        "executionMode": "branch"
      }
    },
    {
      "matchManagers": ["custom.regex"],
      "matchDepNames": ["ghcr.io/cloudnative-pg/postgresql"],
      "postUpgradeTasks": {
        "commands": ["bash ./renovate-update-chart-values.sh '{{{parentDir}}}' '{{{updateType}}}' '{{{currentValue}}}' '{{{newValue}}}'"],
        "executionMode": "branch"
      }
    },
    {
      "matchUpdateTypes": ["minor", "patch"],
      "automerge": true,
      "automergeType": "pr",
      "platformAutomerge": false
    }
  ],
  "prHourlyLimit": 0,
  "prConcurrentLimit": 0,
  "timezone": "Europe/Berlin"
}
